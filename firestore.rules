rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Rol que viene en el custom claim del token. Sin claim => 'user'.
    function role() {
      return request.auth.token.get('role', 'user');
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isProfessionalOrAbove() {
      return isSignedIn() && role() in ['professional', 'admin'];
    }

    function validName(v) {
      return v == null || (v is string && v.size() <= 100);
    }

    function validPhoto(v) {
      return v == null || (v is string && v.size() <= 2048);
    }

    // ---------- users (profiles) ----------

    match /users/{userId} {
      // Cada quien lee su perfil; un admin puede leer y listar todos.
      allow read: if isOwner(userId) || isAdmin();

      // Crear: solo tu propio perfil, exactamente estos campos, y el email
      // debe coincidir con el del token. El campo `role` NO se puede enviar
      // desde el cliente: solo lo escribe el servidor (Admin SDK).
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.get('email', null)
        && validName(request.resource.data.displayName)
        && validPhoto(request.resource.data.photoURL)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Actualizar: solo displayName (y el sello updatedAt). Nadie puede
      // cambiar `role` desde el cliente, ni siquiera un admin: los cambios
      // de rol pasan por la ruta del servidor.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        && validName(request.resource.data.displayName)
        && request.resource.data.updatedAt == request.time;

      // Los perfiles no se borran desde el cliente.
      allow delete: if false;
    }

    // ---------- businesses ----------

    function validBusiness(d) {
      return d.keys().hasOnly(['name', 'category', 'description', 'phone', 'city', 'address', 'status', 'ownerId', 'createdAt', 'updatedAt'])
        && d.ownerId is string
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.category in ['barber', 'dentist', 'doctor', 'nutritionist', 'psychologist', 'other']
        && d.description is string && d.description.size() <= 1000
        && d.phone is string && d.phone.size() >= 7 && d.phone.size() <= 20
        && d.city is string && d.city.size() >= 2 && d.city.size() <= 80
        && d.address is string && d.address.size() >= 5 && d.address.size() <= 160
        && d.status in ['draft', 'published']
        && d.updatedAt == request.time;
    }

    match /businesses/{businessId} {
      // Los negocios publicados son públicos. Borradores: solo dueño o admin.
      allow read: if resource.data.status == 'published'
        || isOwner(resource.data.ownerId)
        || isAdmin();

      // Solo profesionales/admins crean, y solo a su nombre.
      allow create: if isProfessionalOrAbove()
        && isOwner(request.resource.data.ownerId)
        && request.resource.data.keys().hasAll(['name', 'category', 'description', 'phone', 'city', 'address', 'status', 'ownerId', 'createdAt', 'updatedAt'])
        && validBusiness(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if
        // El dueño edita; ownerId y createdAt nunca cambian.
        (
          isProfessionalOrAbove()
          && isOwner(resource.data.ownerId)
          && validBusiness(request.resource.data)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
        )
        // Moderación: un admin solo puede regresar un negocio a borrador.
        || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'draft'
          && request.resource.data.updatedAt == request.time
        );

      // El dueño puede borrar; el admin también, por moderación.
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // ---------- Todo lo demás: denegado ----------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
