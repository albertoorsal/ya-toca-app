rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role from the custom claim in the token. No claim => 'user'.
    function role() {
      return request.auth.token.get('role', 'user');
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isProfessionalOrAbove() {
      return isSignedIn() && role() in ['professional', 'admin'];
    }

    function validName(v) {
      return v == null || (v is string && v.size() <= 100);
    }

    function validPhoto(v) {
      return v == null || (v is string && v.size() <= 2048);
    }

    // ---------- users (profiles) ----------

    match /users/{userId} {
      // Owners read their profile; admins can read and list all of them.
      allow read: if isOwner(userId) || isAdmin();

      // Create: only your own profile, exactly these fields, and the email
      // must match the one in your token. `role` can NOT be sent from the
      // client: only the server (Admin SDK) writes it.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.get('email', null)
        && validName(request.resource.data.displayName)
        && validPhoto(request.resource.data.photoURL)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Update: only displayName (and updatedAt). Nobody changes `role` from
      // the client, not even admins: role changes go through the API route.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        && validName(request.resource.data.displayName)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ---------- Everything else: denied ----------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
